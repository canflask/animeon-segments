{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/REPLACE_OWNER/animeon-segments/schema/segments.schema.json",
  "title": "AnimeOn Community Skip database",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "segments"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "animeId",
          "animeSlug",
          "episode",
          "translation",
          "category",
          "segment",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100
          },
          "animeId": {
            "type": "integer",
            "minimum": 1
          },
          "animeSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "episode": {
            "type": "integer",
            "minimum": 1
          },
          "translation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "category": {
            "enum": ["opening", "ending"]
          },
          "segment": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 28800
              },
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 28800
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "status": {
            "const": "approved"
          }
        }
      }
    }
  }
}
